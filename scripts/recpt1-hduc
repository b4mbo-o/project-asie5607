#!/usr/bin/env python3
"""recpt1-compatible HDUC terrestrial recording client."""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import os
import re
import socket
import sys
from pathlib import Path

from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

sys.path.insert(0, str(Path(__file__).resolve().parent))
from transform_hduc_x64_stream import (  # noqa: E402
    DEFAULT_MATERIAL,
    StreamStats,
    load_material,
    packet_stream,
    transform_packet,
)


VERSION = "recpt1-hduc 0.1"


def parse_record_time(value: str) -> int:
    """Return seconds; zero is the daemon protocol's indefinite duration."""
    if value == "-":
        return 0
    if value.isdigit():
        seconds = int(value)
        if seconds > 0:
            return seconds
        raise ValueError("recording time must be positive or '-'")
    if ":" in value:
        fields = value.split(":")
        if len(fields) not in (2, 3) or any(not field.isdigit() for field in fields):
            raise ValueError("invalid colon recording time")
        numbers = [int(field) for field in fields]
        if len(numbers) == 2:
            hours, minutes, seconds = 0, numbers[0], numbers[1]
        else:
            hours, minutes, seconds = numbers
        if minutes >= 60 or seconds >= 60:
            raise ValueError("minutes and seconds must be below 60")
        total = hours * 3600 + minutes * 60 + seconds
        if total > 0:
            return total
        raise ValueError("recording time must be positive")
    match = re.fullmatch(
        r"(?:(\d+)[Hh])?(?:(\d+)[Mm])?(?:(\d+)[Ss]?)?", value
    )
    if match and any(part is not None for part in match.groups()):
        hours, minutes, seconds = (int(part or 0) for part in match.groups())
        total = hours * 3600 + minutes * 60 + seconds
        if total > 0:
            return total
    raise ValueError(f"invalid recording time: {value}")


def receive_line(connection: socket.socket, limit: int = 256) -> str:
    data = bytearray()
    while len(data) < limit:
        byte = connection.recv(1)
        if not byte:
            raise RuntimeError("hducd closed before its response")
        if byte == b"\n":
            return data.decode("ascii", "replace")
        data += byte
    raise RuntimeError("hducd response was too long")


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        usage="%(prog)s [options] channel rectime destfile",
    )
    parser.add_argument("--socket", type=Path,
                        default=Path(os.environ.get("HDUC_SOCKET", "/tmp/hduc.sock")))
    parser.add_argument("--device", type=Path, dest="device_socket",
                        help="recpt1-compatible alias for --socket")
    parser.add_argument("--material", type=Path, default=DEFAULT_MATERIAL)
    parser.add_argument("--b25", action="store_true")
    parser.add_argument("--strip", action="store_true")
    parser.add_argument("--sid")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("channel", nargs="?")
    parser.add_argument("rectime", nargs="?")
    parser.add_argument("destfile", nargs="?")
    args = parser.parse_args()

    if args.version:
        print(VERSION)
        return 0
    if None in (args.channel, args.rectime, args.destfile):
        parser.error("channel, rectime, and destfile are required")
    try:
        channel = int(args.channel, 10)
    except ValueError as exc:
        parser.error("HDUC currently accepts physical terrestrial channels 13..62")
        raise AssertionError from exc
    if not 13 <= channel <= 62:
        parser.error("HDUC currently accepts physical terrestrial channels 13..62")
    try:
        seconds = parse_record_time(args.rectime)
    except ValueError as exc:
        parser.error(str(exc))

    if args.b25 or args.strip or args.sid:
        parser.error(
            "--b25/--strip/--sid are not in the first backend milestone; "
            "record standard TS first or place a separately installed B25 stage after this command"
        )
    socket_path = args.device_socket or args.socket
    if args.dry_run:
        print(
            f"socket={socket_path} channel={channel} "
            f"seconds={'indefinite' if seconds == 0 else seconds} output={args.destfile}"
        )
        return 0

    try:
        _rotated, key, mask = load_material(args.material)
    except (OSError, KeyError, ValueError) as exc:
        print(f"invalid mode-6 material: {exc}", file=sys.stderr)
        return 2

    output_path = None if args.destfile == "-" else Path(args.destfile)
    if output_path is not None:
        output_path.parent.mkdir(parents=True, exist_ok=True)
    target_context = (
        contextlib.nullcontext(sys.stdout.buffer)
        if output_path is None else output_path.open("wb")
    )

    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        connection.connect(str(socket_path))
        connection.sendall(f"RECORD {channel} {seconds}\n".encode("ascii"))
        response = receive_line(connection)
        if response != "OK":
            print(f"hducd rejected recording: {response}", file=sys.stderr)
            return 2

        decryptor = Cipher(algorithms.AES(key), modes.ECB()).decryptor()
        stats = StreamStats()
        digest = hashlib.sha256()
        source = connection.makefile("rb", buffering=0)
        print(
            f"recording physical ch{channel} for "
            f"{'until signal' if seconds == 0 else f'{seconds}s'} from {socket_path}",
            file=sys.stderr,
            flush=True,
        )
        with source, target_context as target:
            for packet in packet_stream(source, stats):
                transformed = transform_packet(packet, decryptor, mask)
                target.write(transformed)
                digest.update(transformed)
            target.flush()
            decryptor.finalize()
    except KeyboardInterrupt:
        print("recording interrupted", file=sys.stderr)
        return 130
    except BrokenPipeError:
        return 0
    except (OSError, RuntimeError) as exc:
        print(f"recpt1-hduc: {exc}", file=sys.stderr)
        return 2
    finally:
        connection.close()

    print(
        f"recording complete: packets={stats.packets} bytes={stats.packets * 188} "
        f"resync_gaps={len(stats.gaps)} skipped={sum(length for _, length in stats.gaps)} "
        f"trailing={stats.trailing} sha256={digest.hexdigest()}",
        file=sys.stderr,
    )
    return 0 if stats.packets else 2


if __name__ == "__main__":
    raise SystemExit(main())
